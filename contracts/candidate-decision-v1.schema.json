{
  "$defs": {
    "ActorKind": {
      "enum": [
        "user",
        "agent",
        "tool",
        "import"
      ],
      "title": "ActorKind",
      "type": "string"
    },
    "Approval": {
      "additionalProperties": false,
      "description": "Explicit human approval for a record written by another actor.",
      "properties": {
        "approved_at": {
          "format": "date-time",
          "title": "Approved At",
          "type": "string"
        },
        "approved_by": {
          "minLength": 1,
          "title": "Approved By",
          "type": "string"
        }
      },
      "required": [
        "approved_by",
        "approved_at"
      ],
      "title": "Approval",
      "type": "object"
    },
    "CandidateKind": {
      "enum": [
        "tool",
        "library",
        "service",
        "technique",
        "pattern",
        "model",
        "dataset",
        "repository",
        "topic",
        "other"
      ],
      "title": "CandidateKind",
      "type": "string"
    },
    "DecisionStatus": {
      "enum": [
        "inbox",
        "accepted",
        "rejected",
        "deferred"
      ],
      "title": "DecisionStatus",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "How a record was produced; not a claim that its content is true.",
      "properties": {
        "actor_id": {
          "minLength": 1,
          "title": "Actor Id",
          "type": "string"
        },
        "actor_kind": {
          "$ref": "#/$defs/ActorKind"
        },
        "method": {
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "model_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "actor_kind",
        "actor_id",
        "method"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "approval": {
      "anyOf": [
        {
          "$ref": "#/$defs/Approval"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "candidate_id": {
      "pattern": "^cand_[0-9a-f]{64}$",
      "title": "Candidate Id",
      "type": "string"
    },
    "decided_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decided At"
    },
    "key": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9:._/-]*$",
      "title": "Key",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/CandidateKind"
    },
    "project_id": {
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "title": "Project Id",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "rationale": {
      "default": "",
      "title": "Rationale",
      "type": "string"
    },
    "schema_version": {
      "const": "candidate-decision/v1",
      "default": "candidate-decision/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/DecisionStatus",
      "default": "inbox"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "candidate_id",
    "project_id",
    "key",
    "kind",
    "title",
    "provenance"
  ],
  "title": "CandidateDecision",
  "type": "object"
}
