{
  "$defs": {
    "CandidateKind": {
      "enum": [
        "tool",
        "library",
        "service",
        "technique",
        "pattern",
        "model",
        "dataset",
        "repository",
        "topic",
        "other"
      ],
      "title": "CandidateKind",
      "type": "string"
    },
    "FitLevel": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "FitLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "aliases": {
      "default": [],
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "pattern": "^[a-z0-9][a-z0-9:._/-]*$",
        "type": "string"
      },
      "title": "Aliases",
      "type": "array"
    },
    "candidate_id": {
      "pattern": "^cand_[0-9a-f]{64}$",
      "title": "Candidate Id",
      "type": "string"
    },
    "first_capture_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "First Capture At"
    },
    "fit": {
      "$ref": "#/$defs/FitLevel"
    },
    "key": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9:._/-]*$",
      "title": "Key",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/CandidateKind"
    },
    "last_capture_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Capture At"
    },
    "mention_count": {
      "default": 0,
      "minimum": 0,
      "title": "Mention Count",
      "type": "integer"
    },
    "mention_ids": {
      "default": [],
      "items": {
        "pattern": "^men_[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Mention Ids",
      "type": "array"
    },
    "merged_from": {
      "default": [],
      "items": {
        "pattern": "^cand_[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Merged From",
      "type": "array"
    },
    "project_id": {
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "const": "candidate-record/v1",
      "default": "candidate-record/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_ids": {
      "default": [],
      "items": {
        "pattern": "^src_[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Source Ids",
      "type": "array"
    },
    "stale": {
      "default": false,
      "title": "Stale",
      "type": "boolean"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "candidate_id",
    "project_id",
    "key",
    "kind",
    "title",
    "fit"
  ],
  "title": "Candidate",
  "type": "object"
}
