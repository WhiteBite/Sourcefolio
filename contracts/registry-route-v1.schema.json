{
  "$defs": {
    "ActorKind": {
      "enum": [
        "user",
        "agent",
        "tool",
        "import"
      ],
      "title": "ActorKind",
      "type": "string"
    },
    "AnchorField": {
      "enum": [
        "description",
        "comment",
        "ocr",
        "caption",
        "title"
      ],
      "title": "AnchorField",
      "type": "string"
    },
    "CandidateKind": {
      "enum": [
        "tool",
        "library",
        "service",
        "technique",
        "pattern",
        "model",
        "dataset",
        "repository",
        "topic",
        "other"
      ],
      "title": "CandidateKind",
      "type": "string"
    },
    "CandidateMention": {
      "additionalProperties": false,
      "properties": {
        "anchor": {
          "$ref": "#/$defs/MentionAnchor"
        },
        "candidate_key": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9:._/-]*$",
          "title": "Candidate Key",
          "type": "string"
        },
        "fit": {
          "$ref": "#/$defs/FitLevel"
        },
        "kind": {
          "$ref": "#/$defs/CandidateKind"
        },
        "mention_id": {
          "pattern": "^men_[0-9a-f]{64}$",
          "title": "Mention Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "mention_id",
        "candidate_key",
        "kind",
        "title",
        "fit",
        "anchor"
      ],
      "title": "CandidateMention",
      "type": "object"
    },
    "FitLevel": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "FitLevel",
      "type": "string"
    },
    "MentionAnchor": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "anyOf": [
            {
              "pattern": "^art_[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Id"
        },
        "comment_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comment Index"
        },
        "end_char": {
          "exclusiveMinimum": 0,
          "title": "End Char",
          "type": "integer"
        },
        "extraction_id": {
          "anyOf": [
            {
              "pattern": "^ext_[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extraction Id"
        },
        "field": {
          "$ref": "#/$defs/AnchorField"
        },
        "quote": {
          "maxLength": 500,
          "minLength": 8,
          "title": "Quote",
          "type": "string"
        },
        "start_char": {
          "minimum": 0,
          "title": "Start Char",
          "type": "integer"
        }
      },
      "required": [
        "field",
        "quote",
        "start_char",
        "end_char"
      ],
      "title": "MentionAnchor",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "How a record was produced; not a claim that its content is true.",
      "properties": {
        "actor_id": {
          "minLength": 1,
          "title": "Actor Id",
          "type": "string"
        },
        "actor_kind": {
          "$ref": "#/$defs/ActorKind"
        },
        "method": {
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "model_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "actor_kind",
        "actor_id",
        "method"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "RouteVerdict": {
      "enum": [
        "candidate",
        "irrelevant",
        "insufficient_signal"
      ],
      "title": "RouteVerdict",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "capture_id": {
      "pattern": "^cap_[0-9a-f]{64}$",
      "title": "Capture Id",
      "type": "string"
    },
    "captured_at": {
      "format": "date-time",
      "title": "Captured At",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "fit": {
      "$ref": "#/$defs/FitLevel",
      "default": "low"
    },
    "limitations": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "mentions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CandidateMention"
      },
      "title": "Mentions",
      "type": "array"
    },
    "model": {
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "pre_rank": {
      "default": 0,
      "minimum": 0,
      "title": "Pre Rank",
      "type": "integer"
    },
    "project_id": {
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "title": "Project Id",
      "type": "string"
    },
    "prompt_fingerprint": {
      "pattern": "^[0-9a-f]{16}$",
      "title": "Prompt Fingerprint",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "reason": {
      "default": "",
      "title": "Reason",
      "type": "string"
    },
    "route_id": {
      "pattern": "^rt_[0-9a-f]{64}$",
      "title": "Route Id",
      "type": "string"
    },
    "schema_version": {
      "const": "registry-route/v1",
      "default": "registry-route/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_id": {
      "pattern": "^src_[0-9a-f]{64}$",
      "title": "Source Id",
      "type": "string"
    },
    "source_title": {
      "default": "",
      "title": "Source Title",
      "type": "string"
    },
    "source_url": {
      "default": "",
      "title": "Source Url",
      "type": "string"
    },
    "verdict": {
      "$ref": "#/$defs/RouteVerdict"
    }
  },
  "required": [
    "route_id",
    "source_id",
    "capture_id",
    "project_id",
    "model",
    "prompt_fingerprint",
    "verdict",
    "captured_at",
    "provenance",
    "created_at"
  ],
  "title": "RegistryRoute",
  "type": "object"
}
